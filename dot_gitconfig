[user]
	email = git@sebastian.klamar.name
	name = Sebastian Klamar
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEJObRCJFqmtQcLjdhzxIbM+PKfezWlK5FPxiwFqCO34
[core]
	#excludesfile = ~/.gitignore
[alias]
	co = checkout
	ci = commit
	up = pull
	st = status
	stat = status
	lg = log --color --graph --pretty=format:'%Cgreen%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	lgdate = log --color --graph --pretty=format:'%Cgreen%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cd) %C(bold blue)(%ad)%Creset' --abbrev-commit --date=human
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = false
